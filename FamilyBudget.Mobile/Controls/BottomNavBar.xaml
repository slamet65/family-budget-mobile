<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FamilyBudget.Mobile.Controls.BottomNavBar">

    <Grid ColumnDefinitions="*,*,*,*"
          HeightRequest="84"
          BackgroundColor="{StaticResource SurfaceContainer}">

        <BoxView Grid.Column="0" Grid.ColumnSpan="4"
                 HeightRequest="1" VerticalOptions="Start"
                 Color="#E4DFE6" />

        <Border Grid.Column="0" x:Name="WalletsPill"
                StrokeShape="RoundRectangle 18" Stroke="Transparent"
                BackgroundColor="Transparent" Padding="0"
                WidthRequest="78" HeightRequest="58"
                HorizontalOptions="Center" VerticalOptions="Center">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnWalletsTapped" />
            </Border.GestureRecognizers>
            <VerticalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                <Label x:Name="WalletsIcon" Text="&#128091;" FontSize="19" HorizontalOptions="Center" />
                <Label x:Name="WalletsLabel" Text="Wallets" FontSize="11" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Border>

        <Border Grid.Column="1" x:Name="TransactionsPill"
                StrokeShape="RoundRectangle 18" Stroke="Transparent"
                BackgroundColor="Transparent" Padding="0"
                WidthRequest="78" HeightRequest="58"
                HorizontalOptions="Center" VerticalOptions="Center">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnTransactionsTapped" />
            </Border.GestureRecognizers>
            <VerticalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                <Label x:Name="TransactionsIcon" Text="&#8596;" FontSize="19" HorizontalOptions="Center" />
                <Label x:Name="TransactionsLabel" Text="Transactions" FontSize="11" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Border>

        <Border Grid.Column="2" x:Name="BudgetsPill"
                StrokeShape="RoundRectangle 18" Stroke="Transparent"
                BackgroundColor="Transparent" Padding="0"
                WidthRequest="78" HeightRequest="58"
                HorizontalOptions="Center" VerticalOptions="Center">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBudgetsTapped" />
            </Border.GestureRecognizers>
            <VerticalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                <Label x:Name="BudgetsIcon" Text="&#9637;" FontSize="19" HorizontalOptions="Center" />
                <Label x:Name="BudgetsLabel" Text="Budgets" FontSize="11" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Border>

        <Border Grid.Column="3" x:Name="MorePill"
                StrokeShape="RoundRectangle 18" Stroke="Transparent"
                BackgroundColor="Transparent" Padding="0"
                WidthRequest="78" HeightRequest="58"
                HorizontalOptions="Center" VerticalOptions="Center">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMoreTapped" />
            </Border.GestureRecognizers>
            <VerticalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                <Label x:Name="MoreIcon" Text="&#9776;" FontSize="19" HorizontalOptions="Center" />
                <Label x:Name="MoreLabel" Text="More" FontSize="11" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentView>
