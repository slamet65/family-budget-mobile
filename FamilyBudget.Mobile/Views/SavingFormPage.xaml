<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FamilyBudget.Mobile.ViewModels" xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             x:DataType="vm:SavingFormViewModel" x:Class="FamilyBudget.Mobile.Views.SavingFormPage"
             Title="{Binding PageTitle}" BackgroundColor="{StaticResource Surface}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <VerticalStackLayout Spacing="4">
                <Label Text="Nama" FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" />
                <Entry Text="{Binding Name}" Placeholder="mis. Dana Darurat" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="4">
                <Label Text="Catatan (opsional)" FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" />
                <Editor Text="{Binding Note}" AutoSize="TextChanges" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="4">
                <Label Text="Saldo awal (Rp)" FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" />
                <Entry Text="{Binding OpeningBalanceText}" Keyboard="Numeric" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="4">
                <Label Text="Tanggal saldo awal" FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" />
                <DatePicker Date="{Binding OpeningBalanceDate}" MaximumDate="{x:Static sys:DateTime.Today}" />
            </VerticalStackLayout>
            <Button Text="Simpan" Command="{Binding SaveCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" Margin="0,10,0,0" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
