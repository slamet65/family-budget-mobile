<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FamilyBudget.Mobile.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             x:DataType="vm:PeriodCloseViewModel"
             x:Class="FamilyBudget.Mobile.Views.PeriodClosePage"
             Title="Close period"
             BackgroundColor="{StaticResource Surface}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Step 1: count wallets -->
            <VerticalStackLayout Spacing="16" IsVisible="{Binding IsReviewStep, Converter={StaticResource InverseBoolConverter}}">

                <Label Text="{Binding PeriodDisplayName, StringFormat='Closing: {0}'}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource OnSurface}" />
                <Label Text="Count the physical balance of each wallet. Any gap from the system-computed balance is recorded as an adjustment."
                       FontSize="13" TextColor="{StaticResource OnSurfaceVariant}" />

                <CollectionView ItemsSource="{Binding WalletEntries}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:WalletCountEntry">
                            <Border StrokeShape="RoundRectangle 16" Stroke="Transparent"
                                    BackgroundColor="{StaticResource SurfaceContainer}" Padding="14"
                                    Margin="0,0,0,10">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding WalletName}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource OnSurface}" />
                                    <Label Text="{Binding SystemBalance, Converter={StaticResource MoneyConverter}, StringFormat='System balance: {0}'}"
                                           FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" />
                                    <Entry Text="{Binding CountedBalanceText}" Keyboard="Numeric" Placeholder="Counted balance (Rp)" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <VerticalStackLayout Spacing="4">
                    <Label Text="New period start date" FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" />
                    <DatePicker Date="{Binding NewPeriodStartDate}" MaximumDate="{x:Static sys:DateTime.Today}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="New period name (optional)" FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" />
                    <Entry Text="{Binding NewPeriodName}" Placeholder="e.g. Agustus 2026" />
                </VerticalStackLayout>

                <Button Text="Close period"
                        Command="{Binding ConfirmCloseCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                        BackgroundColor="{StaticResource Error}"
                        Margin="0,10,0,0" />

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />

            </VerticalStackLayout>

            <!-- Step 2: result -->
            <VerticalStackLayout Spacing="16" IsVisible="{Binding IsReviewStep}">

                <Border StrokeShape="RoundRectangle 20" Stroke="Transparent"
                        BackgroundColor="{StaticResource SuccessContainer}" Padding="16">
                    <Label Text="Period closed." TextColor="{StaticResource Success}" FontAttributes="Bold" />
                </Border>

                <Label Text="Wallet reconciliation" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource OnSurface}" />

                <CollectionView ItemsSource="{Binding Reconciliations}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ReconciliationDisplayItem">
                            <Border StrokeShape="RoundRectangle 16" Stroke="Transparent"
                                    BackgroundColor="{StaticResource SurfaceContainer}" Padding="14"
                                    Margin="0,0,0,10">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding WalletName}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource OnSurface}" />
                                    <Label FontSize="12" TextColor="{StaticResource OnSurfaceVariant}">
                                        <Label.Text>
                                            <MultiBinding StringFormat="System {0} · Counted {1}">
                                                <Binding Path="SystemBalance" Converter="{StaticResource MoneyConverter}" />
                                                <Binding Path="CountedBalance" Converter="{StaticResource MoneyConverter}" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                    <Label Text="{Binding Difference, Converter={StaticResource MoneyConverter}, StringFormat='Adjustment: {0}'}"
                                           FontSize="13" FontAttributes="Bold"
                                           TextColor="{Binding Difference, Converter={StaticResource AmountSignColorConverter}}"
                                           IsVisible="{Binding Difference, Converter={StaticResource NonZeroConverter}}" />
                                    <Label Text="No discrepancy." FontSize="13" TextColor="{StaticResource Success}"
                                           IsVisible="{Binding Difference, Converter={StaticResource NonZeroConverter}, ConverterParameter=invert}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Border StrokeShape="RoundRectangle 20" Stroke="Transparent"
                        BackgroundColor="{StaticResource PrimaryContainer}" Padding="16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding NewPeriodDisplayName, StringFormat='New period opened: {0}'}"
                               TextColor="{StaticResource OnPrimaryContainer}" FontAttributes="Bold" />
                        <Label Text="{Binding CopiedBudgetsCount, StringFormat='{0} budget line(s) carried over, editable in the new period.'}"
                               FontSize="12" TextColor="{StaticResource OnPrimaryContainer}" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="Done" Command="{Binding DoneCommand}" Margin="0,10,0,0" />

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
