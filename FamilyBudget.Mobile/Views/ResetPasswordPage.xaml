<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FamilyBudget.Mobile.ViewModels"
             x:DataType="vm:ResetPasswordViewModel"
             x:Class="FamilyBudget.Mobile.Views.ResetPasswordPage"
             Title="Atur Ulang Kata Sandi"
             BackgroundColor="{StaticResource Surface}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="{Binding UserName, StringFormat='Atur kata sandi baru untuk {0}'}"
                   FontSize="16" TextColor="{StaticResource OnSurface}" />

            <VerticalStackLayout Spacing="4">
                <Label Text="Kata sandi baru (min. 8 karakter)" FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" />
                <Entry Text="{Binding NewPassword}" IsPassword="True" Placeholder="Kata sandi baru" />
            </VerticalStackLayout>

            <Button Text="Atur Ulang Kata Sandi"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                    Margin="0,10,0,0" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
