<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FamilyBudget.Mobile.ViewModels" xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:behaviors="clr-namespace:FamilyBudget.Mobile.Behaviors"
             x:DataType="vm:SavingExpenseFormViewModel" x:Class="FamilyBudget.Mobile.Views.SavingExpenseFormPage"
             Title="{Binding PageTitle}" BackgroundColor="{StaticResource Surface}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8"
                  IsEnabled="{Binding IsEditMode, Converter={StaticResource InverseBoolConverter}}">
                <Button Grid.Row="0" Grid.Column="0" Text="Setor" Command="{Binding SetTypeCommand}" CommandParameter="deposit"
                        BackgroundColor="{StaticResource SurfaceContainer}" TextColor="{StaticResource OnSurfaceVariant}">
                    <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding SelectedType}" Value="deposit"><Setter Property="BackgroundColor" Value="{StaticResource SecondaryContainer}" /><Setter Property="TextColor" Value="{StaticResource OnSecondaryContainer}" /></DataTrigger></Button.Triggers>
                </Button>
                <Button Grid.Row="0" Grid.Column="1" Text="Tarik" Command="{Binding SetTypeCommand}" CommandParameter="withdrawal"
                        BackgroundColor="{StaticResource SurfaceContainer}" TextColor="{StaticResource OnSurfaceVariant}">
                    <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding SelectedType}" Value="withdrawal"><Setter Property="BackgroundColor" Value="{StaticResource SecondaryContainer}" /><Setter Property="TextColor" Value="{StaticResource OnSecondaryContainer}" /></DataTrigger></Button.Triggers>
                </Button>
                <Button Grid.Row="1" Grid.Column="0" Text="Pengeluaran" Command="{Binding SetTypeCommand}" CommandParameter="expense"
                        BackgroundColor="{StaticResource SurfaceContainer}" TextColor="{StaticResource OnSurfaceVariant}">
                    <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding SelectedType}" Value="expense"><Setter Property="BackgroundColor" Value="{StaticResource SecondaryContainer}" /><Setter Property="TextColor" Value="{StaticResource OnSecondaryContainer}" /></DataTrigger></Button.Triggers>
                </Button>
                <Button Grid.Row="1" Grid.Column="1" Text="Transfer" Command="{Binding SetTypeCommand}" CommandParameter="transfer"
                        BackgroundColor="{StaticResource SurfaceContainer}" TextColor="{StaticResource OnSurfaceVariant}">
                    <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding SelectedType}" Value="transfer"><Setter Property="BackgroundColor" Value="{StaticResource SecondaryContainer}" /><Setter Property="TextColor" Value="{StaticResource OnSecondaryContainer}" /></DataTrigger></Button.Triggers>
                </Button>
            </Grid>

            <VerticalStackLayout Spacing="4" IsVisible="{Binding NeedsWallet}">
                <Label Text="{Binding WalletLabel}" FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" />
                <Picker ItemsSource="{Binding Wallets}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedWallet}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4" IsVisible="{Binding IsTransfer}">
                <Label Text="Ke tabungan" FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" />
                <Picker ItemsSource="{Binding TargetSavings}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedTargetSaving}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Jumlah (Rp)" FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" />
                <Entry Text="{Binding AmountText}" Keyboard="Numeric" Placeholder="0">
                    <Entry.Behaviors><behaviors:ThousandsSeparatorBehavior /></Entry.Behaviors>
                </Entry>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="4"><Label Text="Tanggal" FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" /><DatePicker Date="{Binding OccurredAt}" MaximumDate="{x:Static sys:DateTime.Today}" /></VerticalStackLayout>
            <VerticalStackLayout Spacing="4"><Label Text="Catatan (opsional)" FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" /><Editor Text="{Binding Note}" AutoSize="TextChanges" /></VerticalStackLayout>
            <Button Text="Simpan" Command="{Binding SaveCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" Margin="0,10,0,0" />
            <Button Text="Hapus" Command="{Binding DeleteCommand}" IsVisible="{Binding IsEditMode}" BackgroundColor="{StaticResource Error}" TextColor="White" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
