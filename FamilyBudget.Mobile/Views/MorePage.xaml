<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FamilyBudget.Mobile.ViewModels"
             xmlns:controls="clr-namespace:FamilyBudget.Mobile.Controls"
             x:DataType="vm:MoreViewModel"
             x:Class="FamilyBudget.Mobile.Views.MorePage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource Surface}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- App bar -->
        <Grid Grid.Row="0" Padding="20,18">
            <Label Text="More" FontSize="24" FontAttributes="Bold" VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,4,16,20" Spacing="0">

                <!-- User info card -->
                <Border StrokeShape="RoundRectangle 20"
                        Stroke="Transparent"
                        BackgroundColor="{StaticResource PrimaryContainer}"
                        Padding="18"
                        Margin="0,0,0,22">
                    <HorizontalStackLayout Spacing="14">
                        <Border WidthRequest="46" HeightRequest="46"
                                StrokeShape="RoundRectangle 23"
                                Stroke="Transparent"
                                BackgroundColor="{StaticResource Surface}">
                            <Label Text="&#128100;" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="{Binding UserDisplay}" FontSize="15" FontAttributes="Bold"
                               TextColor="{StaticResource OnPrimaryContainer}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Categories -->
                <Border StrokeShape="RoundRectangle 20" Stroke="Transparent"
                        BackgroundColor="{StaticResource SurfaceContainer}" Padding="16" Margin="0,0,0,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToCategoriesCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Grid.Column="0" WidthRequest="42" HeightRequest="42"
                                StrokeShape="RoundRectangle 13" Stroke="Transparent"
                                BackgroundColor="{StaticResource SecondaryContainer}">
                            <Label Text="&#127991;" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="Categories" FontSize="15" TextColor="{StaticResource OnSurface}" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="&#8250;" FontSize="21" TextColor="{StaticResource OnSurfaceVariant}" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Periods -->
                <Border StrokeShape="RoundRectangle 20" Stroke="Transparent"
                        BackgroundColor="{StaticResource SurfaceContainer}" Padding="16" Margin="0,0,0,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToPeriodsCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Grid.Column="0" WidthRequest="42" HeightRequest="42"
                                StrokeShape="RoundRectangle 13" Stroke="Transparent"
                                BackgroundColor="{StaticResource SecondaryContainer}">
                            <Label Text="&#128197;" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="Periods" FontSize="15" TextColor="{StaticResource OnSurface}" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="&#8250;" FontSize="21" TextColor="{StaticResource OnSurfaceVariant}" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Family members -->
                <Border StrokeShape="RoundRectangle 20" Stroke="Transparent"
                        BackgroundColor="{StaticResource SurfaceContainer}" Padding="16" Margin="0,0,0,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToFamilyMembersCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Grid.Column="0" WidthRequest="42" HeightRequest="42"
                                StrokeShape="RoundRectangle 13" Stroke="Transparent"
                                BackgroundColor="{StaticResource SecondaryContainer}">
                            <Label Text="&#128106;" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="Family members" FontSize="15" TextColor="{StaticResource OnSurface}" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="&#8250;" FontSize="21" TextColor="{StaticResource OnSurfaceVariant}" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Log out -->
                <Border StrokeShape="RoundRectangle 20" Stroke="Transparent"
                        BackgroundColor="{StaticResource SurfaceContainer}" Padding="16" Margin="0,14,0,0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding LogoutCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Grid.Column="0" WidthRequest="42" HeightRequest="42"
                                StrokeShape="RoundRectangle 13" Stroke="Transparent"
                                BackgroundColor="{StaticResource SurfaceContainerHigh}">
                            <Label Text="&#128682;" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="Log out" FontSize="15" TextColor="{StaticResource Error}" VerticalOptions="Center" />
                        <ActivityIndicator Grid.Column="2" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <controls:BottomNavBar Grid.Row="2" ActiveTab="more" />

    </Grid>

</ContentPage>
