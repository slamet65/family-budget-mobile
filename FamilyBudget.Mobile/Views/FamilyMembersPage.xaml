<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FamilyBudget.Mobile.ViewModels"
             xmlns:dtos="clr-namespace:FamilyBudget.Mobile.Services.Api.Dtos"
             x:DataType="vm:FamilyMembersViewModel"
             x:Class="FamilyBudget.Mobile.Views.FamilyMembersPage"
             Title="Anggota Keluarga"
             BackgroundColor="{StaticResource Surface}">

    <Grid>
        <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Members}" Margin="20,16,20,90">
                <CollectionView.EmptyView>
                    <Label Text="Belum ada anggota keluarga lain. Ketuk + untuk menambahkan."
                           HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center"
                           TextColor="{StaticResource OnSurfaceVariant}" Margin="0,40,0,0" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:UserDto">
                        <Border StrokeShape="RoundRectangle 18" Stroke="Transparent"
                                BackgroundColor="{StaticResource SurfaceContainer}" Padding="16"
                                Margin="0,0,0,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer CommandParameter="{Binding .}" Tapped="OnMemberTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <Border Grid.Column="0"
                                        WidthRequest="44" HeightRequest="44"
                                        StrokeShape="RoundRectangle 14"
                                        Stroke="Transparent"
                                        BackgroundColor="{StaticResource SecondaryContainer}">
                                    <Label Text="&#128100;" FontSize="19" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                    <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource OnSurface}" />
                                    <Label Text="{Binding Email}" FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="Atur ulang kata sandi" FontSize="12" FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- FAB -->
        <Border WidthRequest="58" HeightRequest="58"
                StrokeShape="RoundRectangle 18"
                Stroke="Transparent"
                BackgroundColor="{StaticResource PrimaryContainer}"
                HorizontalOptions="End" VerticalOptions="End"
                Margin="0,0,20,20">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnAddFamilyMemberTapped" />
            </Border.GestureRecognizers>
            <Label Text="+" FontSize="29" TextColor="{StaticResource OnPrimaryContainer}" HorizontalOptions="Center" VerticalOptions="Center" />
        </Border>

    </Grid>

</ContentPage>
