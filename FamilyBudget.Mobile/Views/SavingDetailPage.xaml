<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FamilyBudget.Mobile.ViewModels" xmlns:dtos="clr-namespace:FamilyBudget.Mobile.Services.Api.Dtos"
             x:DataType="vm:SavingDetailViewModel" x:Class="FamilyBudget.Mobile.Views.SavingDetailPage"
             Title="{Binding Saving.Name}" BackgroundColor="{StaticResource Surface}">
    <ContentPage.ToolbarItems><ToolbarItem Text="Ubah" Clicked="OnEditSavingTapped" /></ContentPage.ToolbarItems>
    <Grid>
        <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
            <ScrollView>
                <VerticalStackLayout Padding="16,4,16,90" Spacing="0">
                    <Border StrokeShape="RoundRectangle 28" Stroke="Transparent" BackgroundColor="{StaticResource PrimaryContainer}" Padding="22" Margin="0,0,0,22">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Saldo tabungan" FontSize="14" TextColor="{StaticResource OnPrimaryContainer}" Opacity="0.8" />
                            <Label Text="{Binding Saving.Balance, Converter={StaticResource MoneyConverter}}" FontSize="31" FontAttributes="Bold" TextColor="{StaticResource OnPrimaryContainer}" />
                            <Label Text="{Binding Saving.Note}" FontSize="12" TextColor="{StaticResource OnPrimaryContainer}" Opacity="0.75" />
                        </VerticalStackLayout>
                    </Border>
                    <Label Text="Riwayat" FontSize="20" Margin="4,0,0,13" TextColor="{StaticResource OnSurface}" />
                    <CollectionView ItemsSource="{Binding Transactions}">
                        <CollectionView.EmptyView><Label Text="Belum ada transaksi tabungan." HorizontalOptions="Center" Margin="0,20" /></CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dtos:SavingTransactionDto">
                                <Border StrokeShape="RoundRectangle 18" Stroke="Transparent" BackgroundColor="{StaticResource SurfaceContainer}" Padding="14" Margin="0,0,0,10">
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTransactionTapped" CommandParameter="{Binding .}" /></Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                                        <Label Text="{Binding Description}" FontSize="14" TextColor="{StaticResource OnSurface}" />
                                        <Label Grid.Row="1" Text="{Binding OccurredAt, StringFormat='{0:d MMM yyyy}'}" FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" />
                                        <Label Grid.Column="1" Grid.RowSpan="2" Text="{Binding AmountText}" FontSize="15" FontAttributes="Bold" VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsExpense}" Value="True"><Setter Property="TextColor" Value="{StaticResource Error}" /></DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsExpense}" Value="False"><Setter Property="TextColor" Value="{StaticResource Primary}" /></DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
        <Border WidthRequest="58" HeightRequest="58" StrokeShape="RoundRectangle 18" Stroke="Transparent" BackgroundColor="{StaticResource PrimaryContainer}" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,20,20">
            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnAddExpenseTapped" /></Border.GestureRecognizers>
            <Label Text="−" FontSize="29" TextColor="{StaticResource OnPrimaryContainer}" HorizontalOptions="Center" VerticalOptions="Center" />
        </Border>
    </Grid>
</ContentPage>
