<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FamilyBudget.Mobile.ViewModels"
             xmlns:dtos="clr-namespace:FamilyBudget.Mobile.Services.Api.Dtos"
             xmlns:controls="clr-namespace:FamilyBudget.Mobile.Controls"
             x:DataType="vm:TransactionsViewModel"
             x:Class="FamilyBudget.Mobile.Views.TransactionsPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource Surface}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- App bar -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="20,18" ColumnSpacing="12">
            <Label Grid.Column="0" Text="Transactions" FontSize="24" FontAttributes="Bold" VerticalOptions="Center" />
            <Border Grid.Column="1"
                    WidthRequest="42" HeightRequest="42"
                    StrokeShape="RoundRectangle 21"
                    Stroke="Transparent"
                    BackgroundColor="{StaticResource PrimaryContainer}">
                <Label Text="&#128104;&#8205;&#128105;&#8205;&#128103;" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
                <ScrollView>
                    <VerticalStackLayout Padding="16,4,16,90" Spacing="0">

                        <!-- Filters -->
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,0,0,18">
                            <Border Grid.Column="0" StrokeShape="RoundRectangle 16" Stroke="Transparent"
                                    BackgroundColor="{StaticResource SurfaceContainer}" Padding="10,0">
                                <Picker ItemsSource="{Binding PeriodOptions}"
                                        ItemDisplayBinding="{Binding Label}"
                                        SelectedItem="{Binding SelectedPeriodOption}"
                                        TextColor="{StaticResource OnSurface}"
                                        FontSize="12" />
                            </Border>
                            <Border Grid.Column="1" StrokeShape="RoundRectangle 16" Stroke="Transparent"
                                    BackgroundColor="{StaticResource SurfaceContainer}" Padding="10,0">
                                <Picker ItemsSource="{Binding WalletOptions}"
                                        ItemDisplayBinding="{Binding Label}"
                                        SelectedItem="{Binding SelectedWalletOption}"
                                        TextColor="{StaticResource OnSurface}"
                                        FontSize="12" />
                            </Border>
                            <Border Grid.Column="2" StrokeShape="RoundRectangle 16" Stroke="Transparent"
                                    BackgroundColor="{StaticResource SurfaceContainer}" Padding="10,0">
                                <Picker ItemsSource="{Binding TypeOptions}"
                                        ItemDisplayBinding="{Binding Label}"
                                        SelectedItem="{Binding SelectedTypeOption}"
                                        TextColor="{StaticResource OnSurface}"
                                        FontSize="12" />
                            </Border>
                        </Grid>

                        <CollectionView ItemsSource="{Binding Transactions}">
                            <CollectionView.EmptyView>
                                <Label Text="No transactions yet." HorizontalOptions="Center" Margin="0,20" TextColor="{StaticResource OnSurfaceVariant}" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="dtos:TransactionDto">
                                    <Border StrokeShape="RoundRectangle 18"
                                            Stroke="Transparent"
                                            BackgroundColor="{StaticResource SurfaceContainer}"
                                            Padding="14"
                                            Margin="0,0,0,10">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="13">
                                            <Border Grid.Column="0"
                                                    WidthRequest="42" HeightRequest="42"
                                                    StrokeShape="RoundRectangle 14"
                                                    Stroke="Transparent"
                                                    BackgroundColor="{StaticResource Surface}">
                                                <Label Text="{Binding ., Converter={StaticResource TransactionIconConverter}}"
                                                       TextColor="{Binding ., Converter={StaticResource TransactionAmountColorConverter}}"
                                                       FontSize="18" FontAttributes="Bold"
                                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                                <Label Text="{Binding ., Converter={StaticResource TransactionDescriptionConverter}}"
                                                       FontSize="14" TextColor="{StaticResource OnSurface}" />
                                                <Label Text="{Binding OccurredAt, StringFormat='{0:d MMM yyyy}'}"
                                                       FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2"
                                                   Text="{Binding ., Converter={StaticResource TransactionAmountTextConverter}}"
                                                   TextColor="{Binding ., Converter={StaticResource TransactionAmountColorConverter}}"
                                                   FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout>
                </ScrollView>
            </RefreshView>

            <!-- FAB -->
            <Border WidthRequest="58" HeightRequest="58"
                    StrokeShape="RoundRectangle 18"
                    Stroke="Transparent"
                    BackgroundColor="{StaticResource PrimaryContainer}"
                    HorizontalOptions="End" VerticalOptions="End"
                    Margin="0,0,20,20">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAddTransactionTapped" />
                </Border.GestureRecognizers>
                <Label Text="+" FontSize="29" TextColor="{StaticResource OnPrimaryContainer}" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

        </Grid>

        <controls:BottomNavBar Grid.Row="2" ActiveTab="transactions" />

    </Grid>

</ContentPage>
