<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FamilyBudget.Mobile.ViewModels"
             x:DataType="vm:AddUserViewModel"
             x:Class="FamilyBudget.Mobile.Views.AddUserPage"
             Title="Tambah Anggota Keluarga"
             BackgroundColor="{StaticResource Surface}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <VerticalStackLayout Spacing="4">
                <Label Text="Nama" FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" />
                <Entry Text="{Binding Name}" Placeholder="mis. Bunda" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Email" FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" />
                <Entry Text="{Binding Email}" Keyboard="Email" Placeholder="nama@contoh.com" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Kata sandi (min. 8 karakter)" FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" />
                <Entry Text="{Binding Password}" IsPassword="True" Placeholder="Kata sandi" />
            </VerticalStackLayout>

            <Button Text="Simpan"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                    Margin="0,10,0,0" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
