<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FamilyBudget.Mobile.ViewModels"
             x:DataType="vm:BudgetEditViewModel"
             x:Class="FamilyBudget.Mobile.Views.BudgetEditPage"
             Title="{Binding PageTitle}"
             BackgroundColor="{StaticResource Surface}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <VerticalStackLayout Spacing="4" IsVisible="{Binding IsEditMode}">
                <Label Text="Category" FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" />
                <Label Text="{Binding CategoryDisplayName}" FontSize="16" TextColor="{StaticResource OnSurface}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4" IsVisible="{Binding IsEditMode, Converter={StaticResource InverseBoolConverter}}">
                <Label Text="Category" FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" />
                <Picker ItemsSource="{Binding AvailableCategories}" ItemDisplayBinding="{Binding Label}" SelectedItem="{Binding SelectedCategoryOption}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Planned amount (Rp)" FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" />
                <Entry Text="{Binding PlannedAmountText}" Keyboard="Numeric" Placeholder="0" />
            </VerticalStackLayout>

            <Button Text="Save"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                    Margin="0,10,0,0" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
