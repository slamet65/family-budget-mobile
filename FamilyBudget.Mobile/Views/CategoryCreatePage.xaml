<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FamilyBudget.Mobile.ViewModels"
             x:DataType="vm:CategoryCreateViewModel"
             x:Class="FamilyBudget.Mobile.Views.CategoryCreatePage"
             Title="New category"
             BackgroundColor="{StaticResource Surface}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <VerticalStackLayout Spacing="4">
                <Label Text="Name" FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" />
                <Entry Text="{Binding Name}" Placeholder="e.g. Jajan" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Parent category" FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" />
                <Picker ItemsSource="{Binding ParentOptions}" ItemDisplayBinding="{Binding Label}" SelectedItem="{Binding SelectedParent}" />
            </VerticalStackLayout>

            <HorizontalStackLayout Spacing="10" IsVisible="{Binding CanBeCatchAll}">
                <CheckBox IsChecked="{Binding IsCatchAll}" />
                <Label Text="This is the catch-all (&quot;Lain-lain&quot;) category" VerticalOptions="Center" TextColor="{StaticResource OnSurface}" />
            </HorizontalStackLayout>

            <Button Text="Save"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                    Margin="0,10,0,0" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
